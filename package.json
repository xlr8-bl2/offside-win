{
  "name": "offside-win",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "worker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "npm -w engine run probe",
    "probe:players": "npm -w engine run probe:players",
    "probe:report": "npm -w engine run probe:report",
    "probe:profile": "npm -w engine run probe:profile",
    "probe:reds": "npm -w engine run probe:reds",
    "history": "npm -w engine run history",
    "ratings": "npm -w engine run ratings",
    "slate": "npm -w engine run slate",
    "slate:loop": "npm -w engine run slate:loop",
    "poster:preview": "npm -w engine run poster:preview",
    "settle": "npm -w engine run settle",
    "grant": "npm -w engine run grant --",
    "plans": "npm -w engine run plans --",
    "whop:check": "npm -w engine run whop:check",
    "gemini:check": "npm -w engine run gemini:check",
    "mail:setup": "npm -w engine run mail:setup",
    "cards": "npm -w engine run cards",
    "lab": "npm -w engine run lab",
    "lab:odds": "npm -w engine run lab:odds",
    "lab:tune": "npm -w engine run lab:tune",
    "lab:backfill": "npm -w engine run lab:backfill",
    "trace": "npm -w engine run trace",
    "backtest": "npm -w engine run backtest",
    "migrate": "npm -w engine run migrate",
    "test": "npm -w engine test && npm -w worker test",
    "typecheck": "npm -w engine run typecheck && npm -w worker run typecheck",
    "dev": "npm -w worker run dev",
    "deploy": "npm -w worker run deploy",
    "supabase:check": "npm -w engine run supabase:check",
    "board:stats": "npm -w engine run board:stats",
    "eval:provider": "npm -w engine run eval:provider",
    "h2h": "npm -w engine run h2h",
    "market": "npm -w engine run market",
    "renew": "npm -w engine run renew",
    "narrate:preview": "npm -w engine run narrate:preview",
    "images": "npm -w engine run images"
  }
}
